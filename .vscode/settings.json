{
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./test",
        "-p",
        "*_test.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Be extremely detail with the file changes and the reason for the change",
        }
    ],
    "files.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
    },
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
    },
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.analysis.indexing": true,
    "python.analysis.exclude": [
        "**/.venv/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**"
    ],
    "python.analysis.ignore": [
        "**/.venv/**",
        "**/cdk.out/**"
    ],
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/cdk.out/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true
    }
}